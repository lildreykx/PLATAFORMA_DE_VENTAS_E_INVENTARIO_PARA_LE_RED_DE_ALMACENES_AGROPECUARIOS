<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AGRO CORE | Sistema de Control Operativo</title>
    <style>
        :root {
            --primary: #10a77b;
            --primary-dark: #087b5a;
            --primary-soft: #e9f7f2;
            --bg: #ffffff;
            --card-bg: #ffffff;
            --text: #17191b;
            --muted: #656a70;
            --border: #dedfe1;
            --danger: #d32f2f;
            --warning: #fbc02d;
            --success: #07966e;
            --shadow: 0 8px 24px rgba(20, 24, 28, 0.06);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 24px 32px;
        }

        header {
            display: grid;
            grid-template-columns: minmax(250px, 0.8fr) minmax(0, 1.2fr);
            grid-template-areas: "brand actions" "branch actions";
            align-items: center;
            background: #fff;
            color: var(--text);
            padding: 10px 0 22px;
            border-bottom: 1px solid var(--border);
            gap: 12px 24px;
        }

        .branch-label {
            grid-area: branch;
            justify-self: start;
            max-width: 230px;
            line-height: 1.5;
        }

        .brand {
            grid-area: brand;
            text-align: left;
        }

        .header-actions {
            grid-area: actions;
            justify-self: stretch;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
            width: 100%;
            min-width: 0;
        }

        header h2 {
            margin: 0;
            font-size: 2rem;
            line-height: 1.1;
            font-weight: 800;
        }

        header small {
            display: inline-block;
            margin-top: 7px;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .network-status {
            min-height: 44px;
            padding: 8px 16px;
            border: 1px solid var(--border);
            border-radius: 3px;
            font-weight: bold;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f7f7f7;
            color: var(--text);
            flex-shrink: 0;
            white-space: nowrap;
        }

        .voice-toggle {
            width: auto;
            min-height: 44px;
            padding: 8px 12px;
            border-color: var(--border);
            background: #fff;
            color: var(--text);
            cursor: pointer;
            white-space: nowrap;
        }

        .voice-toggle[aria-pressed="true"] {
            border-color: #caeade;
            background: #eff9f5;
            color: var(--success);
        }

        .online { border-color: #caeade; background-color: #eff9f5; color: var(--success); }
        .offline { border-color: #f0d0d0; background-color: #fff4f4; color: var(--danger); }
        .demo { border-color: #e1e2e4; background-color: #f4f4f4; color: #555b60; }

        .nav-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            margin: 0 0 24px;
            border-bottom: 1px solid var(--border);
        }

        .tab-btn {
            width: auto;
            margin-bottom: -1px;
            padding: 15px 2px 13px;
            border: 0;
            border-bottom: 3px solid transparent;
            background: transparent;
            color: var(--muted);
            cursor: pointer;
            border-radius: 0;
            font-weight: 700;
            white-space: nowrap;
            font-size: 0.95rem;
            transition: color 0.18s ease, border-color 0.18s ease;
            box-shadow: none;
        }

        .tab-btn:hover {
            color: var(--text);
            background: transparent;
        }

        .tab-btn.active {
            background: transparent;
            border-bottom-color: var(--primary);
            color: var(--text);
            box-shadow: none;
        }

        .tab-content {
            display: none;
            background: var(--card-bg);
            padding: 4px 0 24px;
            border-radius: 0;
            box-shadow: none;
            border: 0;
        }

        .tab-content.active { display: block; }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
            gap: 24px;
        }

        .card {
            border: 1px solid var(--border);
            padding: 22px;
            border-radius: 3px;
            background: #fff;
            box-shadow: none;
        }

        .card h3 {
            margin-top: 0;
            margin-bottom: 16px;
            color: var(--text);
            font-size: 1.15rem;
            font-weight: 700;
        }

        .stock-badge {
            display: inline-block;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .stock-green { background-color: var(--success); }
        .stock-yellow { background-color: var(--warning); }
        .stock-red { background-color: var(--danger); }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }

        select, input, button {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d3d5d7;
            border-radius: 3px;
            box-sizing: border-box;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        select:focus, input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(16, 167, 123, 0.12);
        }

        button.btn-primary {
            background: #17191b;
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.15s ease;
            box-shadow: none;
        }

        button.btn-primary:hover {
            background: #34383b;
        }

        button:disabled {
            background: #d6d7d8;
            color: #656a70;
            box-shadow: none;
            cursor: not-allowed;
        }

        button:focus-visible, select:focus-visible, input:focus-visible {
            outline: 3px solid rgba(16, 167, 123, 0.42);
            outline-offset: 2px;
        }

        .table-scroll {
            width: 100%;
            min-width: 0;
            max-width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .grid > .card {
            min-width: 0;
        }

        .table-scroll table {
            min-width: 0;
            width: 100%;
        }

        .table-scroll table.wide-table {
            min-width: 620px;
        }

        .cart-table {
            min-width: 0;
            table-layout: auto;
        }

        .cart-table th, .cart-table td {
            padding: 10px 8px;
            font-size: 0.82rem;
            white-space: nowrap;
        }

        .cart-table td:first-child {
            min-width: 140px;
            white-space: normal;
        }

        .cart-table button {
            padding: 7px 4px;
            font-size: 0.78rem;
        }

        #cartTable input {
            min-width: 76px;
            padding: 7px;
        }

        .btn-remove {
            width: auto;
            padding: 7px 10px;
            border-color: #efcaca;
            background: #fff5f5;
            color: var(--danger);
            cursor: pointer;
        }

        .toast-region {
            position: fixed;
            z-index: 10;
            right: 20px;
            bottom: 20px;
            display: grid;
            gap: 8px;
            width: min(380px, calc(100vw - 32px));
        }

        .toast {
            padding: 12px 16px;
            border-radius: 8px;
            background: #203c25;
            color: #fff;
            box-shadow: var(--shadow);
        }

        .btn-secondary {
            background: #f4f5f5;
            color: var(--text);
            border: 1px solid var(--border);
            cursor: pointer;
            font-weight: 600;
        }

        .map-wrapper {
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            background: linear-gradient(180deg, #edf7ff 0%, #f7fbff 100%);
        }

        .map-wrapper svg {
            width: 100%;
            height: 320px;
            display: block;
        }

        .warehouse-marker {
            fill: #d94f4f;
            stroke: #fff;
            stroke-width: 2;
        }

        .warehouse-marker.almacen-ok {
            fill: #2ca36b;
        }

        .warehouse-label {
            font-size: 12px;
            fill: #1d2a36;
            font-weight: 700;
        }

        .warehouse-pill {
            fill: rgba(255,255,255,0.92);
            stroke: rgba(18, 35, 52, 0.18);
        }

        .toast.error {
            background: #8d2020;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
            overflow: hidden;
            border-radius: 8px;
        }

        th, td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e7e8e9;
        }

        th {
            background: #f3f4f5;
            color: var(--text);
            font-size: 0.9rem;
            text-transform: uppercase;
            font-weight: 700;
        }

        tbody tr:hover {
            background: #f8f9f9;
        }

        .alert-box {
            background: #fff7f7;
            color: var(--danger);
            padding: 12px 14px;
            border-left: 4px solid var(--danger);
            margin-bottom: 10px;
            border-radius: 2px;
            box-shadow: none;
        }

        .customer-details {
            margin: 18px 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 12px 0;
        }

        .customer-details summary {
            cursor: pointer;
            font-weight: 700;
        }

        .customer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 12px;
            margin-top: 14px;
        }

        .customer-grid .form-group {
            margin: 0;
        }

        .invoice-layout {
            display: grid;
            grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
            gap: 24px;
            align-items: start;
        }

        .invoice-list, .invoice-preview {
            min-width: 0;
            border: 1px solid var(--border);
            padding: 20px;
            background: #fff;
        }

        .invoice-preview[hidden] {
            display: none;
        }

        .invoice-document {
            max-width: 900px;
            margin: 0 auto;
            border: 1px solid #cbd2d4;
            padding: 28px;
            color: #172126;
            background: #fff;
        }

        .invoice-topbar, .invoice-party-row, .invoice-bottom {
            display: flex;
            justify-content: space-between;
            gap: 24px;
        }

        .invoice-topbar {
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 2px solid #dce7e7;
        }

        .invoice-brand {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .invoice-brand-mark {
            display: grid;
            place-items: center;
            width: 48px;
            aspect-ratio: 1;
            background: var(--primary);
            color: #fff;
            font-weight: 800;
            font-size: 1.2rem;
        }

        .invoice-brand h1, .invoice-title p, .invoice-title strong {
            margin: 0;
        }

        .invoice-brand h1 {
            font-size: 1.35rem;
        }

        .invoice-brand p, .invoice-caption, .invoice-footer {
            color: var(--muted);
        }

        .invoice-title {
            min-width: 190px;
            padding: 12px 18px;
            border: 1px solid var(--border);
            text-align: center;
        }

        .invoice-title p {
            margin-bottom: 6px;
            font-weight: 700;
        }

        .invoice-number {
            color: var(--primary-dark);
            overflow-wrap: anywhere;
        }

        .invoice-meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px 20px;
            margin: 18px 0;
            padding: 12px;
            background: #f2f6f6;
        }

        .invoice-meta span, .invoice-customer span {
            display: block;
            color: var(--muted);
            font-size: 0.82rem;
        }

        .invoice-customer {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin: 18px 0;
            border: 1px solid var(--border);
        }

        .invoice-customer > div {
            min-width: 0;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            overflow-wrap: anywhere;
        }

        .invoice-customer > div:nth-child(odd) {
            background: #f2f6f6;
        }

        .invoice-items {
            width: 100%;
            margin: 18px 0;
            border-collapse: collapse;
        }

        .invoice-items th, .invoice-items td {
            padding: 10px 8px;
            border: 1px solid var(--border);
            text-align: left;
        }

        .invoice-items th {
            background: #eaf0f0;
            color: var(--text);
            text-transform: none;
        }

        .invoice-items td:last-child, .invoice-items th:last-child {
            text-align: right;
        }

        .invoice-item-detail {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: 0.75rem;
        }

        .invoice-bottom {
            align-items: start;
        }

        .invoice-terms {
            max-width: 55%;
        }

        .invoice-totals {
            width: min(100%, 300px);
            border-collapse: collapse;
        }

        .invoice-totals td {
            padding: 8px 10px;
            border: 1px solid var(--border);
        }

        .invoice-totals td:last-child {
            text-align: right;
            white-space: nowrap;
        }

        .invoice-totals tr:last-child {
            background: #eaf0f0;
            font-weight: 800;
        }

        .invoice-footer {
            margin-top: 24px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
            font-size: 0.78rem;
        }

        .invoice-actions {
            display: flex;
            gap: 8px;
            margin-top: 18px;
        }

        .invoice-actions button, .invoice-list button {
            width: auto;
        }

        .invoice-status {
            font-size: 0.82rem;
            color: var(--muted);
        }

        .invoice-status.pending {
            color: #8a5a00;
        }

        .invoice-status.confirmed {
            color: var(--success);
        }

        @media (max-width: 900px) {
            body {
                padding: 16px;
            }

            header {
                grid-template-columns: minmax(0, 1fr);
                grid-template-areas: "brand" "actions" "branch";
                gap: 12px;
            }

            .branch-label {
                grid-area: branch;
                max-width: none;
            }

            .brand {
                grid-area: brand;
                text-align: left;
            }

            .header-actions {
                grid-area: actions;
                justify-self: stretch;
                width: 100%;
                justify-content: flex-start;
            }

            .nav-tabs {
                gap: 8px;
            }

            .tab-btn {
                flex: 1 1 45%;
                text-align: center;
                white-space: normal;
            }

            .grid {
                grid-template-columns: minmax(0, 1fr);
            }

            .invoice-layout {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @media (min-width: 901px) {
            #pos .grid {
                grid-template-columns: minmax(320px, 0.8fr) minmax(0, 1.2fr);
            }
        }

        @media (min-width: 769px) and (max-width: 900px) {
            .nav-tabs {
                justify-content: space-between;
                gap: 12px;
            }

            .tab-btn {
                flex: 0 0 auto;
                padding-right: 0;
                padding-left: 0;
                font-size: 0.86rem;
            }
        }

        @media (max-width: 600px) {
            .cart-table {
                min-width: 560px;
            }

            .map-wrapper svg {
                height: auto;
                aspect-ratio: 420 / 760;
            }

            .invoice-document {
                padding: 14px;
            }

            .invoice-topbar, .invoice-bottom {
                flex-direction: column;
            }

            .invoice-title, .invoice-totals {
                width: 100%;
            }

            .invoice-terms {
                max-width: none;
            }

            .invoice-items th, .invoice-items td {
                padding: 7px 5px;
                font-size: 0.78rem;
            }
        }

        @media print {
            @page {
                size: A4;
                margin: 12mm;
            }

            body {
                padding: 0;
                background: #fff;
            }

            body * {
                visibility: hidden !important;
            }

            #facturas, #facturas * {
                visibility: visible !important;
            }

            #facturas {
                display: block !important;
                position: absolute;
                inset: 0;
                padding: 0;
            }

            .invoice-layout {
                display: block;
            }

            .invoice-list, .no-print {
                display: none !important;
            }

            .invoice-preview {
                display: block !important;
                border: 0;
                padding: 0;
            }

            .invoice-document {
                max-width: none;
                border: 0;
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div id="toastRegion" class="toast-region" aria-live="polite" aria-atomic="false"></div>

    <header>
        <small class="branch-label">Red Agropecuaria de Urabá<br>Apartadó / Chigorodó</small>
        <div class="brand">
            <h2 style="margin:0;">AGRO CORE</h2>
            <small>Sistema de Control Operativo</small>
        </div>
        <div class="header-actions">
            <div id="statusBadge" class="network-status online">
                <span id="statusDot">●</span> <span id="statusText">ONLINE</span>
            </div>
            <button type="button" id="voiceToggle" class="voice-toggle" aria-pressed="false" onclick="toggleVoiceAlerts()">Activar alertas por voz</button>
            <a href="/admin" style="width: auto; padding: 6px 12px; font-size: 0.8em; white-space: nowrap; text-decoration:none; display:inline-block; border:1px solid #d3d5d7; border-radius:3px; background:#fff; color:#17191b; font-weight:600;">Administrador</a>
            <button onclick="toggleNetwork()" style="width: auto; padding: 6px 12px; font-size: 0.8em; white-space: nowrap;">Simular sin conexión</button>
        </div>
    </header>

    <div class="nav-tabs">
        <button class="tab-btn active" data-tab="pos" onclick="switchTab('pos', event)">Ventas POS</button>
        <button class="tab-btn" data-tab="facturas" onclick="switchTab('facturas', event)">Facturas (<span id="invoiceCount">0</span>)</button>
        <button class="tab-btn" data-tab="bodega" onclick="switchTab('bodega', event)">Bodega y lotes</button>
        <button class="tab-btn" data-tab="alertas" onclick="switchTab('alertas', event)">Alertas</button>
        <button class="tab-btn" data-tab="sync" onclick="switchTab('sync', event)">Sincronización (<span id="syncCount">0</span>)</button>
    </div>

    <!-- MÓDULO POS -->
    <div id="pos" class="tab-content active">
        <div class="grid">
            <div class="card">
                <h3>Facturación en Mostrador</h3>
                <div class="form-group">
                    <label>Estrategia de Precio (Perfil Cliente):</label>
                    <select id="clientStrategy" onchange="updateCartUI()">
                        <option value="detal">Cliente Detal (Tarifa Estándar)</option>
                        <option value="bananera">Empresa Bananera (15% Desc. Volumen)</option>
                        <option value="convenio">Convenio Institucional (20% Subsidio)</option>
                    </select>
                </div>
                <details class="customer-details">
                    <summary>Datos del cliente para la factura</summary>
                    <div class="customer-grid">
                        <div class="form-group">
                            <label for="invoiceCustomerName">Cliente</label>
                            <input id="invoiceCustomerName" type="text" maxlength="200" placeholder="Consumidor final">
                        </div>
                        <div class="form-group">
                            <label for="invoiceCustomerId">NIT / identificación</label>
                            <input id="invoiceCustomerId" type="text" maxlength="50" placeholder="Opcional">
                        </div>
                        <div class="form-group">
                            <label for="invoiceCustomerPhone">Teléfono</label>
                            <input id="invoiceCustomerPhone" type="tel" maxlength="50" placeholder="Opcional">
                        </div>
                        <div class="form-group">
                            <label for="invoiceCustomerAddress">Dirección</label>
                            <input id="invoiceCustomerAddress" type="text" maxlength="200" placeholder="Opcional">
                        </div>
                        <div class="form-group">
                            <label for="invoiceCustomerCity">Ciudad</label>
                            <input id="invoiceCustomerCity" type="text" maxlength="100" placeholder="Apartadó">
                        </div>
                        <div class="form-group">
                            <label for="invoicePaymentTerms">Condición de pago</label>
                            <select id="invoicePaymentTerms">
                                <option value="Pago inmediato">Pago inmediato</option>
                                <option value="Crédito a 15 días">Crédito a 15 días</option>
                                <option value="Crédito a 30 días">Crédito a 30 días</option>
                            </select>
                        </div>
                    </div>
                </details>
                <div class="form-group">
                    <label>Seleccionar Agroquímico / Fertilizante:</label>
                    <select id="posProductSelect">
                        <!-- Cargado dinámicamente -->
                    </select>
                </div>
                <div class="form-group">
                    <label>Cantidad (Sacos / Litros):</label>
                    <input type="number" id="posQuantity" value="1" min="1">
                </div>
                <button class="btn-primary" onclick="addToCart()">Agregar a la Factura</button>
            </div>

            <div class="card">
                <h3>Resumen de Factura</h3>
                <div class="table-scroll"><table class="cart-table">
                    <thead>
                        <tr><th>Producto</th><th>Cant.</th><th>Precio unitario</th><th>Subtotal</th><th>Acción</th></tr>
                    </thead>
                    <tbody id="cartTable">
                        <tr><td colspan="5" style="text-align:center;">Carrito vacío</td></tr>
                    </tbody>
                </table></div>
                <h3 style="text-align: right; margin-top: 15px;">Total: $<span id="cartTotal">0.00</span></h3>
                <p id="discountSummary" aria-live="polite">Sin descuento</p>
                <button class="btn-primary" id="btnProcessSale" onclick="processSale()" disabled>Confirmar y Facturar</button>
            </div>
        </div>
        <div class="card" style="margin-top: 24px;">
            <h3>Mapa de la región de Urabá</h3>
            <div class="map-wrapper">
                <svg id="urabaMapPos" viewBox="0 0 900 520" preserveAspectRatio="xMidYMid meet" aria-label="Mapa de la región de Urabá"></svg>
            </div>
        </div>
    </div>

    <!-- MÓDULO BODEGA -->
    <div id="bodega" class="tab-content">
        <div class="grid">
            <div class="card">
                <h3>Registro Rápido de Bodega (Tablet / QR)</h3>
                <div class="form-group">
                    <button class="btn-primary" onclick="simulateQRScan()">📷 Simular escaneo de lote</button>
                </div>
                <div class="form-group">
                    <label>Producto:</label>
                    <select id="whProduct" onchange="selectWarehouseProduct()" aria-label="Producto para movimiento de inventario"></select>
                </div>
                <div class="form-group">
