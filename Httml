    <script src="/uraba-map.js"></script>
    <script>
        // ESTADO DE LA APLICACIÓN
        let isOnline = navigator.onLine;
        let serverMode = 'checking';
        let cart = [];
        let offlineQueue = [];
        let alerts = [];
        let invoices = [];
        let voiceAlertsEnabled = localStorage.getItem('agroVoiceAlertsEnabled') === 'true';
        let voiceQueue = [];
        let isSpeakingAlert = false;
        let depletedProductIds = new Set();

        try {
            depletedProductIds = new Set(JSON.parse(localStorage.getItem('agroVoiceDepletedProducts') || '[]').map(String));
        } catch (error) {
            console.warn('No se pudieron leer las alertas de voz previas:', error);
        }

        try {
            offlineQueue = JSON.parse(localStorage.getItem('agroOfflineSales') || '[]');
            if (!Array.isArray(offlineQueue)) offlineQueue = [];
        } catch (error) {
            console.warn('No se pudo leer la cola local:', error);
        }

        try {
            const storedInvoices = JSON.parse(localStorage.getItem('agroInvoices') || '[]');
            if (Array.isArray(storedInvoices)) invoices = storedInvoices;
        } catch (error) {
            console.warn('No se pudo leer el historial local de facturas:', error);
        }

        function escapeInvoiceText(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[character]);
        }

        function formatInvoiceMoney(value) {
            return `$${Number(value || 0).toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function formatInvoiceDate(value) {
            const date = new Date(value);
            return Number.isNaN(date.getTime())
                ? 'Fecha no disponible'
                : new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
        }

        function persistInvoices() {
            try {
                localStorage.setItem('agroInvoices', JSON.stringify(invoices.slice(0, 100)));
                return true;
            } catch (error) {
                console.error('No se pudo guardar el historial de facturas:', error);
                showMessage('No se pudo conservar la factura en este dispositivo.', true);
                return false;
            }
        }

        function saveInvoice(invoice) {
            invoices = [invoice, ...invoices.filter(saved => String(saved.id) !== String(invoice.id))]
                .sort((first, second) => new Date(second.date) - new Date(first.date))
                .slice(0, 100);
            persistInvoices();
            renderInvoices();
        }

        function renderInvoices() {
            const body = document.getElementById('invoiceTableBody');
            const count = document.getElementById('invoiceCount');
            if (count) count.textContent = String(invoices.length);
            if (!body) return;

            if (!invoices.length) {
                body.innerHTML = '<tr><td colspan="5" style="text-align:center;">Aún no hay facturas.</td></tr>';
                return;
            }

            body.innerHTML = invoices.map(invoice => {
                const pending = String(invoice.status || '').toLowerCase().includes('pendiente');
                return `
                    <tr>
                        <td><strong>${escapeInvoiceText(invoice.number || invoice.id)}</strong></td>
                        <td>${escapeInvoiceText(invoice.customer?.name || 'Consumidor final')}</td>
                        <td>${formatInvoiceMoney(invoice.total)}</td>
                        <td><span class="invoice-status ${pending ? 'pending' : 'confirmed'}">${escapeInvoiceText(invoice.status || 'Confirmada')}</span></td>
                        <td><button type="button" data-invoice-id="${escapeInvoiceText(invoice.id)}">Ver</button></td>
                    </tr>
                `;
            }).join('');

            body.querySelectorAll('[data-invoice-id]').forEach(button => {
                button.addEventListener('click', () => showSavedInvoice(button.dataset.invoiceId));
            });
        }

        function showSavedInvoice(invoiceId) {
            const invoice = invoices.find(saved => String(saved.id) === String(invoiceId));
            const preview = document.getElementById('invoicePreview');
            if (!invoice || !preview) return;

            const customer = invoice.customer || {};
            const items = Array.isArray(invoice.items) ? invoice.items : [];
            const lines = items.map(item => `
                <tr>
                    <td><strong>${escapeInvoiceText(item.name)}</strong><span class="invoice-item-detail">Lote: ${escapeInvoiceText(item.lot || 'N/A')}</span></td>
                    <td><strong>${escapeInvoiceText(item.branch || invoice.branch || 'Sede no indicada')}</strong><span class="invoice-item-detail">${escapeInvoiceText(item.warehouse || item.branch || '')}</span></td>
                    <td>${Number(item.qty || 0)}</td>
                    <td>${formatInvoiceMoney(item.subtotal)}</td>
                </tr>
            `).join('');

            preview.hidden = false;
            preview.innerHTML = `
                <article class="invoice-document">
                    <div class="invoice-topbar">
                        <div class="invoice-brand">
                            <span class="invoice-brand-mark">AC</span>
                            <div><h1>AGRO CORE</h1><p>Sistema de Control Operativo · Urabá</p></div>
                        </div>
                        <div class="invoice-title">
                            <p>Factura de venta</p>
                            <strong class="invoice-number">No. ${escapeInvoiceText(invoice.number || invoice.id)}</strong>
                        </div>
                    </div>
                    <div class="invoice-meta">
                        <div><span>Generación</span><strong>${escapeInvoiceText(formatInvoiceDate(invoice.date))}</strong></div>
                        <div><span>Expedición</span><strong>${escapeInvoiceText(formatInvoiceDate(invoice.date))}</strong></div>
                        <div><span>Vencimiento</span><strong>${escapeInvoiceText(formatInvoiceDate(invoice.dueDate || invoice.date))}</strong></div>
                        <div><span>Sede(s)</span><strong>${escapeInvoiceText(invoice.branch || 'Urabá')}</strong></div>
                        <div><span>Estrategia comercial</span><strong>${escapeInvoiceText(invoice.strategyLabel || 'Cliente detal')}</strong></div>
                        <div><span>Estado</span><strong>${escapeInvoiceText(invoice.status || 'Confirmada')}</strong></div>
                    </div>
                    <div class="invoice-caption"><strong>Datos del cliente</strong></div>
                    <div class="invoice-customer">
                        <div><span>Señor(es)</span><strong>${escapeInvoiceText(customer.name || 'Consumidor final')}</strong></div>
                        <div><span>NIT / identificación</span><strong>${escapeInvoiceText(customer.identification || 'No informado')}</strong></div>
                        <div><span>Teléfono</span><strong>${escapeInvoiceText(customer.phone || 'No informado')}</strong></div>
                        <div><span>Ciudad</span><strong>${escapeInvoiceText(customer.city || 'No informada')}</strong></div>
                        <div><span>Dirección</span><strong>${escapeInvoiceText(customer.address || 'No informada')}</strong></div>
                        <div><span>Condición de pago</span><strong>${escapeInvoiceText(invoice.paymentTerms || 'Pago inmediato')}</strong></div>
                    </div>
                    <table class="invoice-items">
                        <thead><tr><th>Producto / lote</th><th>Sede / almacén</th><th>Cantidad</th><th>Valor</th></tr></thead>
                        <tbody>${lines || '<tr><td colspan="4">Sin detalle de productos</td></tr>'}</tbody>
                    </table>
                    <div class="invoice-bottom">
                        <div class="invoice-terms">
                            <p><strong>Total de artículos:</strong> ${items.reduce((sum, item) => sum + Number(item.qty || 0), 0)}</p>
                            <p><strong>Condiciones de pago:</strong> ${escapeInvoiceText(invoice.paymentTerms || 'Pago inmediato')}</p>
                            <p><strong>Observaciones:</strong> ${escapeInvoiceText(invoice.strategyLabel || 'Venta AgroCore')}</p>
                        </div>
                        <table class="invoice-totals">
                            <tbody>
                                <tr><td>Subtotal</td><td>${formatInvoiceMoney(invoice.subtotal)}</td></tr>
                                <tr><td>Descuento</td><td>${formatInvoiceMoney(invoice.discountAmount)}</td></tr>
                                <tr><td>Impuestos no configurados</td><td>${formatInvoiceMoney(invoice.taxAmount)}</td></tr>
                                <tr><td>Total a pagar</td><td>${formatInvoiceMoney(invoice.total)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="invoice-footer">
                        <p>Documento comercial interno de AgroCore. No sustituye una factura electrónica validada por la DIAN.</p>
                        <p>Conserve este comprobante para consultas de inventario, sede y venta.</p>
                    </div>
                    <div class="invoice-actions no-print">
                        <button type="button" class="btn-primary" onclick="window.print()">Imprimir factura</button>
                    </div>
                </article>
            `;
            switchTab('facturas');
        }

        function createInvoiceDraft(invoiceId) {
            const multiplier = getDiscountMultiplier();
            const items = cart.map(cartItem => {
                const product = inventory.find(item => String(item.id) === String(cartItem.id));
                return {
                    id: String(cartItem.id),
                    name: product?.name || cartItem.name,
                    qty: Number(cartItem.qty),
                    unitPrice: Number(product?.price ?? cartItem.price),
                    subtotal: Number((Number(product?.price ?? cartItem.price) * Number(cartItem.qty) * multiplier).toFixed(2)),
                    branch: product?.branch || 'Sede principal',
                    warehouse: product?.warehouse || product?.branch || 'Sede principal',
                    lot: product?.lot || 'N/A'
                };
            });
            const subtotal = items.reduce((sum, item) => sum + item.unitPrice * item.qty, 0);
            const now = new Date();
            const stamp = now.toISOString().slice(0, 10).replace(/-/g, '');
            const strategy = document.getElementById('clientStrategy').value;
            const paymentTerms = document.getElementById('invoicePaymentTerms').value;
            const dueDate = new Date(now);
            dueDate.setDate(dueDate.getDate() + (paymentTerms.includes('15') ? 15 : paymentTerms.includes('30') ? 30 : 0));
            const strategyLabels = {
                detal: 'Cliente detal',
                bananera: 'Empresa bananera, descuento 15%',
                convenio: 'Convenio institucional, subsidio 20%'
            };

            return {
                id: invoiceId,
                number: `AGC-${stamp}-${invoiceId.slice(-8).toUpperCase()}`,
                date: now.toISOString(),
                dueDate: dueDate.toISOString(),
                customer: {
                    name: document.getElementById('invoiceCustomerName').value.trim() || 'Consumidor final',
                    identification: document.getElementById('invoiceCustomerId').value.trim(),
                    phone: document.getElementById('invoiceCustomerPhone').value.trim(),
                    address: document.getElementById('invoiceCustomerAddress').value.trim(),
                    city: document.getElementById('invoiceCustomerCity').value.trim()
                },
                paymentTerms,
                branch: [...new Set(items.map(item => item.branch))].join(' / '),
                strategy,
                strategyLabel: strategyLabels[strategy],
                items,
                subtotal: Number(subtotal.toFixed(2)),
                discountAmount: Number((subtotal * (1 - multiplier)).toFixed(2)),
                taxAmount: 0,
                total: Number((subtotal * multiplier).toFixed(2)),
                status: 'Pendiente de confirmación'
            };
        }

        async function loadInvoicesFromAPI() {
            try {
                const response = await fetch('/api/sales');
                if (!response.ok) return;
                const savedInvoices = await response.json();
                if (!Array.isArray(savedInvoices)) return;

                const mergedInvoices = new Map(invoices.map(invoice => [String(invoice.id), invoice]));
                savedInvoices.forEach(invoice => mergedInvoices.set(String(invoice.id), { ...invoice, status: 'Confirmada' }));
                invoices = [...mergedInvoices.values()].sort((first, second) => new Date(second.date) - new Date(first.date));
                persistInvoices();
                renderInvoices();
            } catch (error) {
                console.warn('No se pudo consultar el historial de facturas en SQL:', error);
            }
        }

        async function refreshConnectionStatus() {
            const badge = document.getElementById('statusBadge');
            const statusText = document.getElementById('statusText');
            if (!navigator.onLine) {
                badge.className = 'network-status offline';
                statusText.textContent = 'SIN CONEXIÓN';
                return;
            }
            try {
                const response = await fetch('/api/health');
                if (!response.ok) throw new Error('API sin respuesta');
                const health = await response.json();
                serverMode = health.mode;
                badge.className = `network-status ${health.mode === 'sql' ? 'online' : 'demo'}`;
                statusText.textContent = health.mode === 'sql' ? 'SQL CONECTADO' : 'MODO DEMO';
                badge.title = health.message;
            } catch (error) {
                serverMode = 'unavailable';
                badge.className = 'network-status offline';
                statusText.textContent = 'API NO DISPONIBLE';
                badge.title = 'Inicia el servidor para conectar con la API y la base de datos.';
            }
        }

        function showMessage(message, isError = false) {
            const region = document.getElementById('toastRegion');
            const toast = document.createElement('div');
            toast.className = `toast${isError ? ' error' : ''}`;
            toast.textContent = message;
            region.appendChild(toast);
            window.setTimeout(() => toast.remove(), 5000);
        }

        function updateVoiceToggle() {
            const button = document.getElementById('voiceToggle');
            const supported = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
            button.disabled = !supported;
            button.setAttribute('aria-pressed', String(voiceAlertsEnabled && supported));
            button.textContent = supported
                ? (voiceAlertsEnabled ? 'Silenciar alertas por voz' : 'Activar alertas por voz')
                : 'Voz no disponible';
            button.title = supported
                ? 'Los productos agotados se anunciarán automáticamente.'
                : 'Este navegador no admite alertas habladas.';
        }

        function toggleVoiceAlerts() {
            if (!('speechSynthesis' in window) || !('SpeechSynthesisUtterance' in window)) {
                showMessage('Este navegador no admite alertas por voz.', true);
                return;
            }

            voiceAlertsEnabled = !voiceAlertsEnabled;
            localStorage.setItem('agroVoiceAlertsEnabled', String(voiceAlertsEnabled));
            if (voiceAlertsEnabled) {
                updateVoiceToggle();
                speakStockAlert('Alertas por voz activadas. Avisaré cuando un producto se agote.');
                inventory.filter(item => Number(item.stock) <= 0).forEach(announceDepletedProduct);
                showMessage('Alertas por voz activadas.');
                return;
            }

            window.speechSynthesis.cancel();
            voiceQueue = [];
            isSpeakingAlert = false;
            updateVoiceToggle();
            showMessage('Alertas por voz silenciadas.');
        }

        function speakStockAlert(message) {
            if (!voiceAlertsEnabled || !('speechSynthesis' in window)) return;
            voiceQueue.push(message);
            if (isSpeakingAlert) return;

            const speakNext = () => {
                if (!voiceAlertsEnabled || !voiceQueue.length) {
                    isSpeakingAlert = false;
                    return;
                }

                isSpeakingAlert = true;
                const utterance = new SpeechSynthesisUtterance(voiceQueue.shift());
                const spanishVoice = window.speechSynthesis.getVoices().find(voice => voice.lang.toLowerCase().startsWith('es'));
                if (spanishVoice) utterance.voice = spanishVoice;
                utterance.lang = spanishVoice?.lang || 'es-CO';
                utterance.rate = 0.95;
                utterance.onend = speakNext;
                utterance.onerror = speakNext;
                window.speechSynthesis.speak(utterance);
            };

            speakNext();
        }

        function announceDepletedProduct(product) {
            const productId = String(product.id);
            if (!voiceAlertsEnabled || depletedProductIds.has(productId)) return;

            depletedProductIds.add(productId);
            localStorage.setItem('agroVoiceDepletedProducts', JSON.stringify([...depletedProductIds]));
            speakStockAlert(`Atención. Se agotó ${product.name} en la sede ${product.branch}.`);
        }

        function observeStockChanges(previousInventory, nextInventory) {
            const previousById = new Map(previousInventory.map(item => [String(item.id), Number(item.stock)]));
            nextInventory.forEach(item => {
                const productId = String(item.id);
                const previousStock = previousById.get(productId);
                const currentStock = Number(item.stock);

                if (currentStock > 0) {
                    depletedProductIds.delete(productId);
                    return;
                }

                if (previousStock > 0 && currentStock <= 0) announceDepletedProduct(item);
            });
            localStorage.setItem('agroVoiceDepletedProducts', JSON.stringify([...depletedProductIds]));
        }

        function saveOfflineQueue(nextQueue = offlineQueue) {
            try {
                localStorage.setItem('agroOfflineSales', JSON.stringify(nextQueue));
                offlineQueue = nextQueue;
                renderOfflineQueue();
                return true;
            } catch (error) {
                console.error('No se pudo conservar la cola offline:', error);
                showMessage('No se pudo guardar la venta en este dispositivo. No cierres esta página.', true);
                return false;
            }
        }

        const fallbackInventory = [
            { id: '1', name: 'Fertilizante Úrea 46%', price: 120000, stock: 15, minStock: 10, lot: 'UT-9921', exp: '2027-05-12', branch: 'Apartadó', warehouse: 'Almacén Norte' },
            { id: '2', name: 'Agroquímico BananoProtect', price: 85000, stock: 4, minStock: 8, lot: 'BP-8812', exp: '2026-11-30', branch: 'Chigorodó', warehouse: 'Bodega Central' },
            { id: '3', name: 'Abono Complejo NPK', price: 140000, stock: 2, minStock: 5, lot: 'NPK-001', exp: '2028-01-15', branch: 'Apartadó', warehouse: 'Patio de carga' },
            { id: '4', name: 'Fungicida Agrícola Premium', price: 95000, stock: 0, minStock: 5, lot: 'FG-4401', exp: '2026-12-01', branch: 'Chigorodó', warehouse: 'Bodega Sur' },
            { id: '5', name: 'Urea Precisagro 46% x 50 kg', price: 124000, stock: 0, minStock: 5, lot: 'POR-RECIBIR', exp: 'N/A', branch: 'Apartadó', warehouse: 'Por recibir' },
            { id: '6', name: 'Nutrimon NPK 10-20-20 x 50 kg', price: 253200, stock: 0, minStock: 5, lot: 'POR-RECIBIR', exp: 'N/A', branch: 'Apartadó', warehouse: 'Por recibir' },
            { id: '7', name: 'Agrimins 8-5-0-6 Colinagro x 46 kg', price: 162000, stock: 0, minStock: 5, lot: 'POR-RECIBIR', exp: 'N/A', branch: 'Apartadó', warehouse: 'Por recibir' },
            { id: '8', name: 'Nutrimon Producción 17-6-18-2 x 50 kg', price: 170900, stock: 0, minStock: 5, lot: 'POR-RECIBIR', exp: 'N/A', branch: 'Apartadó', warehouse: 'Por recibir' },
            { id: '9', name: 'Banagen 250 EC x 250 ml', price: 26000, stock: 0, minStock: 2, lot: 'POR-RECIBIR', exp: 'N/A', branch: 'Apartadó', warehouse: 'Por recibir' }
        ];
        let inventory = [...fallbackInventory];

        function persistInventoryState() {
            try {
                localStorage.setItem('agroInventoryState', JSON.stringify(inventory));
            } catch (error) {
                console.warn('No se pudo conservar el inventario del administrador:', error);
            }
        }

        function loadStoredInventoryState() {
            try {
                const stored = JSON.parse(localStorage.getItem('agroInventoryState') || 'null');
                if (Array.isArray(stored) && stored.length) {
                    inventory = stored;
                }
            } catch (error) {
                console.warn('No se pudo leer el inventario local:', error);
            }
        }

        const branchWarehouseMap = {
            'Apartadó': { label: 'Apartadó', x: 190, y: 170 },
            'Chigorodó': { label: 'Chigorodó', x: 430, y: 142 }
        };

        function randomizeWarehousePositions() {
            const base = { 'Apartadó': { x: 182 + Math.random() * 50, y: 170 + Math.random() * 40 }, 'Chigorodó': { x: 405 + Math.random() * 60, y: 140 + Math.random() * 45 } };
            Object.assign(branchWarehouseMap, base);
        }

        randomizeWarehousePositions();

        async function loadInventoryFromAPI() {
            try {
                const response = await fetch('/api/products');
                if (!response.ok) throw new Error('API no disponible');
                const data = await response.json();
                if (Array.isArray(data) && data.length) {
                    const previousInventory = inventory.map(item => ({ ...item }));
                    inventory = data;
                    applyPendingSalesToInventory();
                    observeStockChanges(previousInventory, inventory);
                    renderInventory();
                    renderAdminInventoryTable();
                    renderAdminProductSelect();
                    renderWarehouseMap();
                    renderPOSProducts();
                    evaluateStockObservers();
                    return;
                }
            } catch (error) {
                console.warn('Falling back to local inventory data:', error);
            }

            const previousInventory = inventory.map(item => ({ ...item }));
            loadStoredInventoryState();
            inventory = inventory.length ? inventory : [...fallbackInventory];
            applyPendingSalesToInventory();
            observeStockChanges(previousInventory, inventory);
            renderInventory();
            renderAdminInventoryTable();
            renderAdminProductSelect();
            renderWarehouseMap();
            renderPOSProducts();
            evaluateStockObservers();
            persistInventoryState();
        }

        function applyPendingSalesToInventory() {
            offlineQueue.forEach(sale => {
                (sale.payload?.cart || []).forEach(pendingItem => {
                    const product = inventory.find(item => String(item.id) === String(pendingItem.id));
                    if (product) product.stock = Math.max(0, product.stock - Number(pendingItem.qty));
                });
            });
        }

        async function loadAlertsFromAPI() {
            try {
                const response = await fetch('/api/alerts');
                if (!response.ok) return;
                const data = await response.json();
                if (Array.isArray(data)) {
                    alerts = data.map(item => `⚠️ <strong>${item.title}</strong>: ${item.message}`);
                    renderAlerts();
                }
            } catch (error) {
                console.warn('No se pudieron cargar alertas:', error);
            }
        }

        function renderAlerts() {
            const container = document.getElementById('alertsContainer');
            if (!alerts.length) {
                container.innerHTML = '<p style="color:#666;">No hay alertas críticas en este momento.</p>';
                return;
            }
            container.innerHTML = alerts.map(a => `<div class="alert-box">${a}</div>`).join('');
        }

        // INICIALIZACIÓN
        window.onload = async function() {
            updateVoiceToggle();
            await refreshConnectionStatus();
            await loadInventoryFromAPI();
            await loadAlertsFromAPI();
            renderInvoices();
            await loadInvoicesFromAPI();
            renderWarehouseMap();
            renderWarehouseProducts();
            renderOfflineQueue();
        };

        window.addEventListener('online', async () => {
            isOnline = true;
            await refreshConnectionStatus();
            if (serverMode === 'sql') await syncOfflineQueue();
        });

        window.addEventListener('offline', () => {
            isOnline = false;
            refreshConnectionStatus();
        });

        // CAMBIO DE PESTAÑAS
        function switchTab(tabId, event) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');

            const targetBtn = event ? event.currentTarget : document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
            if (targetBtn) {
                targetBtn.classList.add('active');
            }
        }

        // SIMULACIÓN RED (ONLINE / OFFLINE)
        function toggleNetwork() {
            isOnline = !isOnline;
            const badge = document.getElementById('statusBadge');
            const statusText = document.getElementById('statusText');
            
            if (isOnline) {
                badge.className = 'network-status online';
                statusText.innerText = 'RECUPERANDO CONEXIÓN';
                refreshConnectionStatus().then(() => {
                    if (serverMode === 'sql') syncOfflineQueue();
                });
            } else {
                badge.className = 'network-status offline';
                statusText.innerText = 'OFFLINE SIMULADO';
            }
        }

        // RENDERIZAR TABLA DE INVENTARIO Y SEMÁFOROS
        function renderInventory() {
            const tbody = document.getElementById('inventoryTable');
            tbody.innerHTML = '';

            inventory.forEach(item => {
                let colorClass = 'stock-green';
                if (item.stock === 0) colorClass = 'stock-red';
                else if (item.stock <= item.minStock) colorClass = 'stock-yellow';

                tbody.innerHTML += `
                    <tr>
                        <td><span class="stock-badge ${colorClass}"></span> ${item.stock === 0 ? 'Sin Stock' : (item.stock <= item.minStock ? 'Bajo' : 'OK')}</td>
                        <td><strong>${item.name}</strong></td>
                        <td>${item.lot}</td>
                        <td>${item.stock} unidades</td>
                        <td>${item.branch}</td>
                    </tr>
                `;
            });
        }

        function renderAdminInventoryTable() {
            const tbody = document.getElementById('adminInventoryTable');
            if (!tbody) return;
            tbody.innerHTML = '';

            inventory.forEach(item => {
                tbody.innerHTML += `
                    <tr>
                        <td>${item.name}</td>
                        <td>${item.stock}</td>
                        <td>${item.warehouse || item.branch}</td>
                        <td>${item.branch}</td>
                    </tr>
                `;
            });
        }

        function renderAdminProductSelect() {
            const select = document.getElementById('adminProductSelect');
            if (!select) return;
            select.innerHTML = '<option value="">Nuevo producto</option>' + inventory.map(item => `<option value="${item.id}">${item.name}</option>`).join('');
        }

        function populateAdminForm(product) {
            const name = product ? product.name : '';
            const price = product ? product.price : 0;
            const stock = product ? product.stock : 0;
            const minStock = product ? product.minStock : 0;
            const branch = product ? product.branch : 'Apartadó';
            const warehouse = product ? (product.warehouse || product.branch) : 'Almacén Norte';
            const lot = product ? product.lot : '';
            const exp = product ? product.exp : '';

            document.getElementById('adminName').value = name;
            document.getElementById('adminPrice').value = price;
            document.getElementById('adminStock').value = stock;
            document.getElementById('adminMinStock').value = minStock;
            document.getElementById('adminBranch').value = branch;
            document.getElementById('adminWarehouse').value = warehouse;
            document.getElementById('adminLot').value = lot;
            document.getElementById('adminExp').value = exp;
        }

        function clearAdminForm() {
            document.getElementById('adminProductSelect').value = '';
            populateAdminForm(null);
        }

        function loadSelectedAdminProduct() {
            const id = document.getElementById('adminProductSelect').value;
            if (!id) {
                populateAdminForm(null);
                return;
            }
            const product = inventory.find(item => String(item.id) === String(id));
            if (product) populateAdminForm(product);
        }

        function saveAdminProduct() {
            const selectedId = document.getElementById('adminProductSelect').value;
            const name = document.getElementById('adminName').value.trim();
            const price = Number(document.getElementById('adminPrice').value || 0);
            const stock = Number(document.getElementById('adminStock').value || 0);
            const minStock = Number(document.getElementById('adminMinStock').value || 0);
            const branch = document.getElementById('adminBranch').value;
            const warehouse = document.getElementById('adminWarehouse').value.trim() || branch;
            const lot = document.getElementById('adminLot').value.trim() || 'N/A';
            const exp = document.getElementById('adminExp').value;

            if (!name) {
                showMessage('Escribe el nombre del producto.', true);
                return;
            }

            if (selectedId) {
                const product = inventory.find(item => String(item.id) === String(selectedId));
                if (product) {
                    product.name = name;
                    product.price = price;
                    product.stock = stock;
                    product.minStock = minStock;
                    product.branch = branch;
                    product.warehouse = warehouse;
                    product.lot = lot;
                    product.exp = exp || product.exp || '';
                }
            } else {
                const newId = String(Date.now());
                inventory.push({ id: newId, name, price, stock, minStock, branch, warehouse, lot, exp });
                if (document.getElementById('whProduct')) renderWarehouseProducts();
                if (document.getElementById('posProductSelect')) renderPOSProducts();
            }

            renderAdminProductSelect();
            renderAdminInventoryTable();
            renderInventory();
            renderWarehouseMap();
            renderPOSProducts();
            renderWarehouseProducts();
            persistInventoryState();
            clearAdminForm();
            showMessage('Producto actualizado en el inventario.');
        }

        function renderUrabaMap(svgId = 'urabaMapMain') {
            window.drawUrabaMap(svgId);
        }

        function renderWarehouseMap() {
            renderUrabaMap('urabaMapPos');
        }

        function renderPOSProducts() {
            const select = document.getElementById('posProductSelect');
            select.innerHTML = '';
            const available = inventory.filter(item => Number(item.stock) > 0);
            if (!available.length) {
                select.innerHTML = '<option value="">No hay productos disponibles</option>';
                return;
            }
            available.forEach(item => {
                select.innerHTML += `<option value="${item.id}">${item.name} - Stock: ${item.stock} ($${Number(item.price).toLocaleString('es-CO')})</option>`;
            });
        }

        function renderWarehouseProducts() {
            const select = document.getElementById('whProduct');
            select.innerHTML = inventory.map(item => `<option value="${item.id}">${item.name}</option>`).join('');
            selectWarehouseProduct();
        }

        function selectWarehouseProduct() {
            const product = inventory.find(item => String(item.id) === document.getElementById('whProduct').value);
            if (!product) return;
            document.getElementById('whLot').value = product.lot === 'N/A' ? '' : product.lot;
            document.getElementById('whExp').value = /^\d{4}-\d{2}-\d{2}$/.test(product.exp) ? product.exp : '';
        }

        // PATRÓN ESTRATEGIA: CÁLCULO DE PRECIOS
        function getDiscountMultiplier() {
            const strategy = document.getElementById('clientStrategy').value;
            if (strategy === 'bananera') return 0.85; // 15% Descuento por volumen
            if (strategy === 'convenio') return 0.80; // 20% Subsidio
            return 1.0; // Detal / Estándar
        }

        function addToCart() {
            const productId = document.getElementById('posProductSelect').value;
            const qty = Number(document.getElementById('posQuantity').value);
            const product = inventory.find(i => i.id === productId);
            const existing = cart.find(c => c.id === productId);
            const requestedQty = (existing ? existing.qty : 0) + qty;

            if (!product || !Number.isInteger(qty) || qty <= 0) {
                showMessage('Indica una cantidad entera mayor a cero.', true);
                return;
            }
            if (requestedQty > product.stock) {
                showMessage(`Stock insuficiente. Disponible: ${product.stock}; ya agregaste ${existing ? existing.qty : 0}.`, true);
                return;
            }

            if (existing) {
                existing.qty += qty;
            } else {
                cart.push({ id: product.id, name: product.name, price: product.price, qty: qty });
            }

            updateCartUI();
            document.getElementById('posQuantity').value = 1;
        }

        function updateCartQuantity(productId, value) {
            const item = cart.find(entry => entry.id === productId);
            const product = inventory.find(entry => entry.id === productId);
            const qty = Number(value);
            if (!item || !product || !Number.isInteger(qty) || qty < 1 || qty > product.stock) {
                showMessage(`Cantidad inválida. Ingresa entre 1 y ${product ? product.stock : 0}.`, true);
                updateCartUI();
                return;
            }
            item.qty = qty;
            updateCartUI();
        }

        function removeCartItem(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartUI();
        }

        function updateCartUI() {
            const tbody = document.getElementById('cartTable');
            tbody.innerHTML = '';
            let total = 0;
            const multiplier = getDiscountMultiplier();

            if (cart.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Carrito vacío</td></tr>';
                document.getElementById('btnProcessSale').disabled = true;
            } else {
                cart.forEach(item => {
                    const subtotal = item.price * item.qty * multiplier;
                    total += subtotal;
                    tbody.innerHTML += `
                        <tr>
                            <td>${item.name}</td>
                            <td><input type="number" min="1" max="${inventory.find(product => product.id === item.id).stock}" value="${item.qty}" aria-label="Cantidad de ${item.name}" onchange="updateCartQuantity('${item.id}', this.value)"></td>
                            <td>$${Number(item.price).toLocaleString('es-CO')}</td>
                            <td>$${subtotal.toLocaleString('es-CO')}</td>
                            <td><button type="button" class="btn-remove" aria-label="Quitar ${item.name}" onclick="removeCartItem('${item.id}')">Quitar</button></td>
                        </tr>
                    `;
                });
                document.getElementById('btnProcessSale').disabled = false;
            }

            document.getElementById('cartTotal').innerText = total.toLocaleString('es-CO');
            document.getElementById('discountSummary').textContent = multiplier < 1
                ? `Descuento aplicado: ${Math.round((1 - multiplier) * 100)}%`
                : 'Sin descuento';
        }

        // PATRÓN OBSERVADOR: EVALUAR STOCK Y GENERAR ALERTAS
        function evaluateStockObservers() {
            alerts = [];
            inventory.forEach(item => {
                if (item.stock <= item.minStock) {
                    alerts.push(`⚠️ <strong>ALERTA DE REABASTECIMIENTO:</strong> El producto <em>${item.name}</em> (Sede ${item.branch}) alcanzó el punto de reorden (${item.stock} unidades restantes).`);
                }
            });

            const container = document.getElementById('alertsContainer');
            if (alerts.length === 0) {
                container.innerHTML = '<p style="color:#666;">No hay alertas críticas en este momento.</p>';
            } else {
                container.innerHTML = alerts.map(a => `<div class="alert-box">${a}</div>`).join('');
            }
        }

        // CONFIRMAR Y FACTURAR (CON ENFOQUE OFFLINE-FIRST)
        async function processSale() {
            if (!cart.length) return;
            const transactionId = `TRX-${crypto.randomUUID()}`;
            const multiplier = getDiscountMultiplier();
            const invoiceDraft = createInvoiceDraft(transactionId);
            const salePayload = {
                id: transactionId,
                cart: cart.map(item => ({ id: item.id, qty: item.qty })),
                strategy: document.getElementById('clientStrategy').value,
                invoice: {
                    number: invoiceDraft.number,
                    date: invoiceDraft.date,
                    dueDate: invoiceDraft.dueDate,
                    customer: invoiceDraft.customer,
                    paymentTerms: invoiceDraft.paymentTerms
                }
            };

            if (!isOnline) {
                const previousInventory = inventory.map(item => ({ ...item }));
                const pendingSale = {
                    id: transactionId,
                    details: cart.map(c => `${c.qty}x ${c.name}`).join(', '),
                    total: cart.reduce((sum, item) => sum + item.price * item.qty * multiplier, 0),
                    timestamp: new Date().toLocaleString(),
                    payload: salePayload
                };
                if (!saveOfflineQueue([...offlineQueue, pendingSale])) return;
                saveInvoice({ ...invoiceDraft, status: 'Pendiente de sincronización' });
                cart.forEach(cartItem => {
                    const item = inventory.find(i => i.id === cartItem.id);
                    if (item) item.stock -= cartItem.qty;
                });
                observeStockChanges(previousInventory, inventory);
                showMessage(`Venta ${transactionId} guardada en este dispositivo; pendiente de sincronización.`);
            } else {
                try {
                    const response = await fetch('/api/sales', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(salePayload)
                    });

                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        if (response.status < 500) {
                            showMessage(result.message || 'No se pudo procesar la venta.', true);
                            return;
                        }
                        throw new Error(result.message || 'Servidor no disponible');
                    }

                    saveInvoice({ ...(result.invoice || invoiceDraft), status: 'Confirmada' });
                    showMessage(`Venta confirmada. Factura ${result.id}, total $${Number(result.total).toLocaleString('es-CO')}.`);
                } catch (error) {
                    console.error(error);
                    const pendingSale = {
                        id: transactionId,
                        details: cart.map(c => `${c.qty}x ${c.name}`).join(', '),
                        total: cart.reduce((sum, item) => sum + item.price * item.qty * multiplier, 0),
                        timestamp: new Date().toLocaleString(),
                        payload: salePayload
                    };
                    if (!saveOfflineQueue([...offlineQueue, pendingSale])) return;
                    saveInvoice({ ...invoiceDraft, status: 'Pendiente de sincronización' });
                    const previousInventory = inventory.map(item => ({ ...item }));
                    cart.forEach(cartItem => {
                        const item = inventory.find(i => i.id === cartItem.id);
                        if (item) item.stock -= cartItem.qty;
                    });
                    observeStockChanges(previousInventory, inventory);
                    showMessage('No hubo confirmación del servidor. Venta guardada localmente para reintento.', true);
                }
            }

            cart = [];
            updateCartUI();
            if (isOnline && offlineQueue.every(sale => sale.id !== transactionId)) {
                await loadInventoryFromAPI();
                await loadAlertsFromAPI();
            } else {
                renderInventory();
                renderPOSProducts();
                evaluateStockObservers();
            }
            document.getElementById('invoiceCustomerName').value = '';
            document.getElementById('invoiceCustomerId').value = '';
            document.getElementById('invoiceCustomerPhone').value = '';
            document.getElementById('invoiceCustomerAddress').value = '';
            document.getElementById('invoiceCustomerCity').value = '';
            document.getElementById('invoicePaymentTerms').value = 'Pago inmediato';
            document.querySelector('.customer-details').open = false;
            showSavedInvoice(transactionId);
        }

        function renderOfflineQueue() {
            const tbody = document.getElementById('offlineTable');
            document.getElementById('syncCount').innerText = offlineQueue.length;

            if (offlineQueue.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;">No hay transacciones pendientes.</td></tr>';
                return;
            }

            tbody.innerHTML = '';
            offlineQueue.forEach(trx => {
                tbody.innerHTML += `
                    <tr>
                        <td><strong>${trx.id}</strong></td>
                        <td>${trx.details}</td>
                        <td>$${trx.total.toLocaleString('es-CO')}</td>
                        <td><span style="color:orange; font-weight:bold;">Pendiente de enviar</span></td>
                    </tr>
                `;
            });
        }

        function syncOfflineQueue() {
            if (!isOnline) {
                showMessage('Sin conexión: no se puede sincronizar todavía.', true);
                return;
            }

            if (offlineQueue.length === 0) {
                showMessage('No hay ventas pendientes.');
                return;
            }

            syncPendingSales();
        }

        async function syncPendingSales() {
            let synced = 0;
            while (offlineQueue.length && isOnline) {
                const sale = offlineQueue[0];
                try {
                    const response = await fetch('/api/sales', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(sale.payload)
                    });
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'El servidor no confirmó la venta.');
                    }
                    const savedInvoice = result.invoice || invoices.find(invoice => String(invoice.id) === String(sale.id));
                    if (savedInvoice) saveInvoice({ ...savedInvoice, status: 'Confirmada' });
                    const remainingSales = offlineQueue.slice(1);
                    if (!saveOfflineQueue(remainingSales)) break;
                    synced += 1;
                } catch (error) {
                    console.error('Sincronización pendiente:', error);
                    showMessage(`La venta ${sale.id} sigue pendiente: ${error.message}`, true);
                    break;
                }
            }
            if (synced) {
                showMessage(`${synced} venta${synced === 1 ? '' : 's'} confirmada${synced === 1 ? '' : 's'} por el servidor.`);
                await loadInventoryFromAPI();
                await loadAlertsFromAPI();
            }
        }

        // SIMULACIÓN DE ESCANEO BODEGA
        function simulateQRScan() {
            if (!inventory.length) {
                showMessage('No hay productos cargados para escanear.', true);
                return;
            }
            const randomProduct = inventory[Math.floor(Math.random() * inventory.length)];
            document.getElementById('whProduct').value = randomProduct.id;
            document.getElementById('whLot').value = randomProduct.lot;
            document.getElementById('whExp').value = /^\d{4}-\d{2}-\d{2}$/.test(randomProduct.exp) ? randomProduct.exp : '';
            document.getElementById('whQty').value = 10;
        }

        async function updateStockFromBodega() {
            const productName = document.getElementById('whProduct').value;
            const qty = Number(document.getElementById('whQty').value);

            const product = inventory.find(i => String(i.id) === productName);
            const movement = document.getElementById('stockMovement').value;
            if (!product) {
                showMessage('Selecciona un producto válido.', true);
                return;
            }
            if (!Number.isInteger(qty) || qty <= 0) {
                showMessage('La cantidad debe ser un entero mayor a cero.', true);
                return;
            }
            if (movement === 'out' && qty > product.stock) {
                showMessage(`No puedes retirar ${qty}; solo hay ${product.stock} unidades.`, true);
                return;
            }

            const payload = {
                productName: product.name,
                qty: qty,
                movement: movement,
                lot: document.getElementById('whLot').value,
                exp: document.getElementById('whExp').value
            };

            try {
                const response = await fetch('/api/stock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Error actualizando stock');
                }

                const previousInventory = inventory.map(item => ({ ...item }));
                product.stock = Number(result.stock);
                product.lot = payload.lot || product.lot;
                product.exp = payload.exp || product.exp;
                observeStockChanges(previousInventory, inventory);
                renderInventory();
                renderPOSProducts();
                renderWarehouseProducts();
                evaluateStockObservers();
                await loadAlertsFromAPI();
                showMessage(`${movement === 'in' ? 'Entrada' : 'Salida'} registrada. Stock de ${product.name}: ${product.stock}.`);
            } catch (error) {
                console.error('Movimiento no confirmado:', error);
                showMessage(`No se actualizó el inventario: ${error.message}`, true);
            }
        }
    </script>
